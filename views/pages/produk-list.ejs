<%- include('../partials/header') %>

    <div class="content-wrapper">
        <div class="container-fluid px-3 px-md-4 my-4">
            <div class="card card-custom p-3 p-md-4 shadow-sm border-0">
                
                <div class="row align-items-center mb-4 g-3">
                    <div class="col-lg-4 col-md-12">
                        <h1 class="fw-bold m-0 fs-3">Daftar Produk</h1>
                        <p class="text-secondary small m-0">Kelola inventaris barang secara realtime</p>
                    </div>

                    <div class="col-lg-8 col-md-12">
                        <div class="d-flex flex-column flex-sm-row justify-content-lg-end gap-2">

                            <form action="/produk" method="GET" class="d-flex gap-2">
                                <div class="input-group">
                                    <input type="text" name="search" class="form-control" placeholder="Cari nama produk..." value="<%= typeof search !== 'undefined' ? search : '' %>" aria-label="Cari nama produk">
                                    <button type="submit" class="btn btn-primary" aria-label="Cari Produk">
                                        <i class="fa-solid fa-magnifying-glass"></i>
                                    </button>
                                </div>
                                <% if (typeof search !== 'undefined' && search) { %>
                                    <a href="/produk" class="btn btn-outline-secondary" aria-label="Reset Pencarian">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </a>
                                <% } %>
                            </form>
                           
                            <a href="/produk/tambah" class="btn btn-success fw-semibold text-nowrap" aria-label="Tambah Produk Baru">
                                <i class="fa-solid fa-plus me-1"></i> Tambah Produk
                            </a>
                        </div>
                    </div>
                </div>

                <% if (produk.length === 0) { %>
                    <div class="text-center py-5 text-secondary">
                        <i class="fa-solid fa-box-open fa-3x mb-3 d-block"></i>
                        <h2 class="h5 text-secondary">Belum ada data produk.</h2>
                    </div>
                <% } else { %>

                    <div class="d-none d-md-block">
                        <h2 class="visually-hidden">Tabel Data Inventaris Produk</h2>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th width="5%" class="text-center">No</th>
                                        <th width="25%">Nama Produk</th>
                                        <th width="15%">Harga</th>
                                        <th width="10%" class="text-center">Stok</th>
                                        <th width="30%">Deskripsi</th>
                                        <th width="15%" class="text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% produk.forEach((item, index) => { %>
                                        <tr>
                                            <td class="text-center fw-bold text-secondary"><%= index + 1 %></td>
                                            <td class="fw-semibold text-dark"><%= item.nama_produk %></td>
                                            <td class="text-success fw-bold">
                                                Rp <%= Number(item.harga).toLocaleString('id-ID') %>
                                            </td>
                                            <td class="text-center">
                                                <% if (item.stok === 0) { %>
                                                    <span class="badge bg-danger">Habis</span>
                                                <% } else if (item.stok < 5) { %>
                                                    <span class="badge bg-warning text-dark"><%= item.stok %></span>
                                                <% } else { %>
                                                    <span class="badge bg-success"><%= item.stok %></span>
                                                <% } %>
                                            </td>
                                            <td class="text-secondary small"><%= item.deskripsi || '-' %></td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="/produk/edit/<%= item.id %>" class="btn btn-outline-warning" aria-label="Edit produk <%= item.nama_produk %>" title="Edit">
                                                        <i class="fa-solid fa-pen-to-square"></i>
                                                    </a>
                                                    <form action="/produk/hapus/<%= item.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus produk ini?')">
                                                        <button type="submit" class="btn btn-outline-danger" aria-label="Hapus produk <%= item.nama_produk %>" title="Hapus">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="d-block d-md-none">
                        <h2 class="visually-hidden">Daftar Kartu Produk</h2>
                        <div class="row g-3">
                            <% produk.forEach((item, index) => { %>
                                <div class="col-12">
                                    <div class="card border shadow-sm p-3 rounded-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <span class="badge bg-secondary mb-1">#<%= index + 1 %></span>
                                                <h3 class="fw-bold text-dark m-0 fs-5"><%= item.nama_produk %></h3>
                                            </div>
                                            <div>
                                                <% if (item.stok === 0) { %>
                                                    <span class="badge bg-danger">Stok: 0</span>
                                                <% } else if (item.stok < 5) { %>
                                                    <span class="badge bg-warning text-dark">Stok: <%= item.stok %></span>
                                                <% } else { %>
                                                    <span class="badge bg-success">Stok: <%= item.stok %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                        
                                        <div class="mb-2">
                                            <span class="text-secondary small d-block">Harga:</span>
                                            <span class="text-success fw-bold fs-6">Rp <%= Number(item.harga).toLocaleString('id-ID') %></span>
                                        </div>

                                        <div class="mb-3">
                                            <span class="text-secondary small d-block">Deskripsi:</span>
                                            <p class="text-secondary small m-0"><%= item.deskripsi || 'Tidak ada deskripsi' %></p>
                                        </div>

                                        <div class="d-flex justify-content-end gap-2 border-top pt-2">
                                            <a href="/produk/edit/<%= item.id %>" class="btn btn-outline-warning btn-sm px-3" aria-label="Edit produk <%= item.nama_produk %>">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                            </a>
                                            <form action="/produk/hapus/<%= item.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus produk ini?')">
                                                <button type="submit" class="btn btn-outline-danger btn-sm px-3" aria-label="Hapus produk <%= item.nama_produk %>">
                                                    <i class="fa-solid fa-trash me-1"></i> Hapus
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

<%- include('../partials/footer') %>
</body>
</html>